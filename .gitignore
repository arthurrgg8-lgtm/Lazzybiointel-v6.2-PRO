# ============================================================
# LazzyBioIntel v6.3 PRO — .gitignore
# ============================================================

# --- Python virtual environment ---
.venv/
venv/
env/
ENV/

# --- Python cache ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# --- InsightFace models (large — auto-downloaded on first run) ---
~/.insightface/
models/
*.onnx

# --- Logs (contain operational data — never commit) ---
*.log
*.log.*
face_verification.log*

# --- Session recovery state ---
.recovery/

# --- Streamlit cache ---
.streamlit/

# --- Test images (may contain sensitive identity data) ---
test_images/
sample_images/
test_data/
*.jpg
*.jpeg
*.png
*.bmp
*.webp

# --- Verification reports / exports ---
verification_*.json
audit_*.json
*.report.json

# --- OS artifacts ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Temp / build ---
*.tmp
*.temp
dist/
build/
*.egg-info/

# --- Environment variables / secrets ---
.env
.env.*
secrets.py
config_local.py

# --- Large binary files ---
*.so
*.dylib
*.dll
*.bin

# --- Local evidence store ---
evidence_locker/
